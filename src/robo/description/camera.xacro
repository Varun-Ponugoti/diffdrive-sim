<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <link name = "camera_sensor">
        <visual>
            <geometry>
                <box size = "0.010 0.03 0.03" />
            </geometry>
        </visual>
    </link>

    <joint name = "camera_joint" type = "fixed" >
        <parent link = "chassis" />
        <child link  = "camera_sensor" />
        <origin xyz = "0.305 0 0.08" rpy = "0 0 0" />
    </joint>

    <link name = "camera_light"></link>

    <joint name = "camera_light_joint" type = "fixed" >
        <parent link = "camera_sensor" />
        <child link = "camera_light" />
        <origin xyz = "0 0 0" rpy = "-1.57 0 1.57" />
    </joint>

    <gazebo reference = "camera_sensor">
        <material> Gazebo/Red </material>
        <sensor name = "camera_sens" type = "camera">
            <pose>0 0 0 0 0 0</pose>
            <visualize>true</visualize>
            <update_rate>10</update_rate>
            <horizontal_fov>1.089</horizontal_fov>
            <image>
                <format>R8G8B8</format>
                <width>640</width>
                <height>480</height>
            </image>
            <clip>
                <near>0.05</near>
                <far>8.0</far>
            </clip>
            <plugin name = "camera_control" filename = "libgazebo_ros_camera.so">
                <frame_name>camera_light</frame_name>
            </plugin>
        </sensor>
    </gazebo>
</robot>

